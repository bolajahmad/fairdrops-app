NODE_ENV=development
APP_VERSION=0.0.0

API_PORT=3001
API_URL=http://localhost:3001
# Which deployments GET /contracts serves, and whose admin role grants API admin rights:
# local, testnet or mainnet.
DEPLOYMENT_ENVIRONMENT=testnet

# First-party web origins, comma-separated. They may use the refresh cookie and sign users in.
APP_ORIGINS=http://localhost:3000
# Express trust proxy setting, so rate limits see the real client address behind a proxy.
TRUST_PROXY=loopback

# ES256 signing key for access tokens, as a private JWK with a kid. Required in production;
# generate one with `pnpm --filter @fairdrops/api auth:generate-key`. When unset outside
# production, each API process generates its own.
AUTH_JWT_PRIVATE_JWK=
AUTH_ISSUER=fairdrops
AUTH_AUDIENCE=fairdrops-api
# Defaults to true in production.
# AUTH_COOKIE_SECURE=false

# Admins for DEPLOYMENT_ENVIRONMENT=local only. Everywhere else, admin rights come from holding
# DEFAULT_ADMIN_ROLE on the deployed FairDrops contracts.
LOCAL_ADMIN_ADDRESSES=

POSTGRES_USER=fairdrops
POSTGRES_PASSWORD=fairdrops
POSTGRES_DB=fairdrops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fairdrops:fairdrops@localhost:5432/fairdrops
DATABASE_POOL_SIZE=10

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337

# Worker: indexer. It copies FairDrops events from each chain's Goldsky subgraph into Postgres;
# see docs/indexer.md. DEPLOYMENT_ENVIRONMENT above picks the chains.
INDEXER_ENABLED=true
# Only index these chain ids (comma-separated). Empty means every indexable chain.
INDEXER_CHAIN_IDS=
INDEXER_POLL_INTERVAL_MS=4000
INDEXER_BATCH_SIZE=500
# Goldsky project the subgraphs are deployed to (project_...). Endpoints are derived from it.
GOLDSKY_PROJECT_ID=
# Optional. Reads the private endpoints, which are not rate limited per IP like public ones.
GOLDSKY_API_TOKEN=
# Optional per-chain override, e.g. a self-hosted graph-node: 10143=http://localhost:8000/...
SUBGRAPH_ENDPOINTS=

# API: live play. See docs/game-runtime.md.
SESSION_MAX_PLAYERS=10000
WS_MAX_CONNECTIONS=20000

# Worker: game sessions. See docs/game-runtime.md.
SESSIONS_ENABLED=true
# 32 random bytes as hex (openssl rand -hex 32). Encrypts session seeds at rest; required in
# production, and must not change while sessions are open.
SESSION_SEED_KEY=
# Holds OPERATOR_ROLE on the FairDrops contracts and commits session seeds. Without it, every
# session fails at its start.
OPERATOR_PRIVATE_KEY=
SESSION_PLANNER_INTERVAL_MS=2000
SESSION_SETTLEMENT_MARGIN_SECONDS=900
SESSION_LOBBY_LEAD_SECONDS=300
SESSION_MAX_OWNED=50
SESSION_LEASE_MS=10000
