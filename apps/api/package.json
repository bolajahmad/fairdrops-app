{
  "name": "@fairdrops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "auth:generate-key": "node scripts/generate-signing-key.ts",
    "games:builtin": "node scripts/builtin-games.ts"
  },
  "dependencies": {
    "@fairdrops/contracts": "workspace:*",
    "@fairdrops/db": "workspace:*",
    "@fairdrops/game-kit": "workspace:*",
    "@fairdrops/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "viem": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fairdrops/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
