{
  "name": "@fairdrops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
