# Copy to .env.local. Next.js reads these at build and dev time.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=testnet
NEXT_PUBLIC_CLAIM_RELAY_ENABLED=true
# Privy app id, the same as PRIVY_APP_ID for the API. Leave empty to offer wallet sign-in only.
NEXT_PUBLIC_PRIVY_APP_ID=
