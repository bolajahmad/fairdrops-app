# Copy to packages/contracts/.env. Forge loads it automatically; it is gitignored.

# Funded key that sends the deployment transaction. It gets no role in the contract.
DEPLOYER_PRIVATE_KEY=

# Role holders. Must be identical on every chain for the address to match.
FAIRDROPS_ADMIN=
FAIRDROPS_VERIFIERS=
FAIRDROPS_OPERATORS=
FAIRDROPS_PAUSERS=

# Optional, defaults shown.
# FAIRDROPS_FEE_RECIPIENT=<FAIRDROPS_ADMIN>
# FAIRDROPS_ADMIN_DELAY=172800
# FAIRDROPS_FEE_BPS=100
# FAIRDROPS_CLAIM_WINDOW=2592000
# FAIRDROPS_VERIFIER_THRESHOLD=1
# FAIRDROPS_SALT=0x... (defaults to keccak256("fairdrops.v1"))
