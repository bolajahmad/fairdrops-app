{
  "name": "@fairdrops/settlement",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures": "vitest run test/parity.test.ts --update",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fairdrops/contracts": "workspace:*",
    "@fairdrops/game-kit": "workspace:*",
    "@fairdrops/shared": "workspace:*",
    "@openzeppelin/merkle-tree": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@fairdrops/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
