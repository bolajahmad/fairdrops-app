{
  "name": "fairdrops",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "prettier --check . && turbo run lint typecheck test build",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@fairdrops/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
